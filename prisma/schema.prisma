// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String
  createdAt            DateTime  @default(now())
  resetToken           String?   @unique
  resetTokenExpiresAt  DateTime?
  children             Child[]
  savedProviders       SavedProvider[]
  enrollments          Enrollment[]
  feedback             Feedback[]
}

model Child {
  id            String         @id @default(cuid())
  parent        User           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId      String
  name          String
  birthYear     Int
}

model Provider {
  id         String    @id @default(cuid())
  name       String
  bio        String
  imageUrl   String
  location   String
  address    String?
  // Geocoded once at data entry and served to the map from the DB -- the
  // browser must never call the Geocoding API (a per-visit geocode of every
  // pin once produced a surprise bill). Null = pin omitted from the map.
  latitude   Float?
  longitude  Float?
  minAge     Int?      @map("min_age")
  maxAge     Int?      @map("max_age")
  websiteUrl String?   @map("websiteURL")
  googleRating Float?
  placeId    String?
  ratingSource String?
  ratingSyncedAt DateTime?
  reviewPros String?
  reviewCons String?
  hasFreeTrial Boolean @default(false)
  freeTrialUrl String?
  categoryId String?   @map("category")
  category   Category? @relation(fields: [categoryId], references: [id])
  savedBy    SavedProvider[]
  enrollments Enrollment[]
}

model SavedProvider {
  id         String   @id @default(cuid())
  parent     User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  createdAt  DateTime @default(now())

  @@unique([parentId, providerId])
}

model Enrollment {
  id         String   @id @default(cuid())
  parent     User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  createdAt  DateTime @default(now())

  @@unique([parentId, providerId])
}

model Feedback {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  email     String?
  type      String   @default("feedback")
  message   String
  pageUrl   String?
  createdAt DateTime @default(now())
}

model ProgramType {
  id       BigInt  @id @default(autoincrement())
  TypeName String?
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  icon      String
  order     Int        @default(0)
  providers Provider[]
}
